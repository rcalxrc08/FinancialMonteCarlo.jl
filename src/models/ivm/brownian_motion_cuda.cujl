function normcdf_internal!(x)
    x .*= 2
    IVM.erfcinv!(x)
    x *= -sqrt(2)
end

function new_randn!(x, mcBaseData)
    rand!(mcBaseData.parallelMode.rng, x)
    normcdf_internal!(x)
    return
end

function simulate!(X_cu, mcProcess::BrownianMotion, mcBaseData::MonteCarloConfiguration{type1, type2, type3, CudaMode}, T::numb) where {numb <: Number, type1 <: Integer, type2 <: Integer, type3 <: StandardMC}
    Nsim = mcBaseData.Nsim
    Nstep = mcBaseData.Nstep

    σ = mcProcess.σ
    μ = mcProcess.μ
    ChainRulesCore.@ignore_derivatives @assert T > 0
    dt = T / Nstep
    mean_bm = μ * dt
    stddev_bm = σ * sqrt(dt)
    isDualZero = mean_bm * stddev_bm * zero(Int8)
    @views fill!(X_cu[:, 1], isDualZero)
    Z = CuArray{Float32}(undef, Nsim)
    for i = 1:Nstep
        new_randn!(Z, mcBaseData)
        @views @inbounds X_cu[:, i+1] .= X_cu[:, i] .+ (mean_bm .+ stddev_bm * Z)
    end
    return
end

function simulate!(X_cu, mcProcess::BrownianMotion, mcBaseData::MonteCarloConfiguration{type1, type2, type3, CudaMode}, T::numb) where {numb <: Number, type1 <: Integer, type2 <: Integer, type3 <: AntitheticMC}
    Nsim = mcBaseData.Nsim
    Nstep = mcBaseData.Nstep

    σ = mcProcess.σ
    μ = mcProcess.μ
    ChainRulesCore.@ignore_derivatives @assert T > 0
    dt = T / Nstep
    mean_bm = μ * dt
    stddev_bm = σ * sqrt(dt)
    isDualZero = mean_bm * stddev_bm * zero(Int8)
    Nsim_2 = div(Nsim, 2)
    X_cu_p = view(X_cu, 1:Nsim_2, :)
    X_cu_m = view(X_cu, (Nsim_2+1):Nsim, :)
    Z = CuArray{Float32}(undef, Nsim_2)
    for i = 1:Nstep
        randn!(CURAND.generator(), Z)
        @views X_cu_p[:, i+1] .= X_cu_p[:, i] .+ (mean_bm .+ stddev_bm .* Z)
        @views X_cu_m[:, i+1] .= X_cu_m[:, i] .+ (mean_bm .- stddev_bm .* Z)
    end
    return
end
